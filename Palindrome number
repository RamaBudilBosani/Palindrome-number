n = int(input("Give the number: "))

def palindrome(nums):
    if nums < 0:
        return False

    nums = str(nums)
    left, right = 0, len(nums) - 1

    while left < right:
        if nums[left] == nums[right]:
            left += 1
            right -= 1
        else:
            return False

    return True

print(palindrome(n))
